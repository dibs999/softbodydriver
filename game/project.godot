; SoftBodyDriver - native desktop game (Godot 4.5+, Windows / macOS / Linux).
; The soft-body physics runs in C++ (GDExtension, bin/) at 2000 Hz on its own thread.

config_version=5

[application]

config/name="SoftBodyDriver"
config/description="Soft-body vehicle simulator: node-beam physics at 2000 Hz, real deformation, cooling and engine damage."
config/version="0.4.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/bg_color=Color(0.06, 0.07, 0.08, 1)

[autoload]

Game="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray()

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.45, 0.6, 0.8, 1)
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
