extends SceneTree
## Wiper cycle, parking, mode switching and rain-shader inputs on a real vehicle.
const Wipers := preload("res://scripts/vehicle_wipers.gd")
var failed := false
func check(value: bool, caption: String) -> void:
	print(caption, ": ", value)
	failed = failed or not value
func _initialize() -> void:
	call_deferred("run")
func run() -> void:
	var host := Node3D.new()
	root.add_child(host)
	var world := SBWorld.new()
	host.add_child(world)
	var game := root.get_node("Game")
	world.material_library = game.make_material_library()
	var path := "res://cars/kestrel_hatch.car.json"
	var car: SBVehicle = game.spawn_vehicle(world, path, Transform3D.IDENTITY)
	var body: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(path)).get("body", {})
	world.sync_visuals()
	var wipers: Node3D = Wipers.new()
	host.add_child(wipers)
	wipers.attach(car, body)
	check(wipers.get_child_count() == 3, "Pane and two wiper arms built")
	wipers.update(0.1, false, 0.0)
	check(not wipers.running and wipers.blade_angle() == 0.0, "Automatic wipers stay parked when dry")
	wipers.update(0.3, true, 0.4)
	check(wipers.running, "Automatic wipers start in rain")
	for i in 6: wipers.update(0.1, true, 0.6)
	var raised: float = wipers.blade_angle()
	check(raised > 0.3 and raised <= Wipers.SWEEP + 1e-4, "Blades sweep up the glass")
	wipers.update(0.1, false, 0.2)
	for i in 40: wipers.update(0.05, false, 0.2)
	check(not wipers.running and absf(wipers.blade_angle()) < 1e-4, "Blades finish the sweep and park after the rain")
	check(wipers.cycle_mode().ends_with("Aus") and wipers.mode == 1, "Mode cycles to off")
	wipers.update(0.2, true, 1.0)
	check(not wipers.running, "Wipers stay off in rain when switched off")
	wipers.cycle_mode()
	wipers.update(0.2, false, 0.0)
	check(wipers.running, "Continuous mode runs when dry")
	var pane: MeshInstance3D = wipers.get_child(0)
	var centre: Vector3 = pane.global_transform * pane.mesh.get_aabb().get_center()
	var local: Vector3 = car.get_visual_basis().inverse() * (centre - car.get_position_ws())
	check(car.get_up().dot(centre - car.get_position_ws()) > 0.5, "Pane lies above the vehicle reference")
	check((centre - car.get_position_ws()).dot(car.get_forward()) > 0.0, "Pane lies ahead of mid-wheelbase")
	print("local ", local)
	wipers.attach(null, {})
	wipers.update(0.1, true, 1.0)
	check(not wipers.visible, "Detached wipers hide")
	print("TEST OK" if not failed else "TEST FAILED")
	quit(1 if failed else 0)
